# Backend environment (backend/.env)
# CORS origins allowed to call the API (comma-separated). Set your production
# frontend origin here when deploying.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Upload / processing limits
MAX_FILE_SIZE_MB=25
MAX_ROWS=20000
MAX_REVIEW_LENGTH=5000
MAX_TOTAL_TEXT_LENGTH=2000000

# Logging
LOG_LEVEL=INFO
